+            parser.parse();
+            spirv_cross::CompilerMSL msl(std::move(parser.get_parsed_ir()));
+
+            spv::ExecutionModel model = spv::ExecutionModelMax;
+            std::string entryName;
+            const std::string requested = entryPointName != nullptr ? entryPointName : "";
+            for (const auto &entry : msl.get_entry_points_and_stages()) {
+                if (requested.empty() || entry.name == requested) {
+                    model = entry.execution_model;
+                    entryName = entry.name;
+                    msl.set_entry_point(entryName, model);
+                    break;
