+            cache.motionFormat != motionTexture->pixelFormat() || cache.outputFormat != target->pixelFormat();
+        if (recreate) {
+            if (cache.scaler != nullptr) {
+                cache.scaler->release();
+                cache.scaler = nullptr;
+            }
+            if (!MTLFX::TemporalScalerDescriptor::supportsDevice(device)) {
+                return fail("unsupported_device");
+            }
+            MTLFX::TemporalScalerDescriptor *descriptor = MTLFX::TemporalScalerDescriptor::alloc()->init();
+            descriptor->setInputWidth(colorTexture->width());
+            descriptor->setInputHeight(colorTexture->height());
+            descriptor->setOutputWidth(target->width());
+            descriptor->setOutputHeight(target->height());
+            descriptor->setColorTextureFormat(colorTexture->pixelFormat());
+            descriptor->setDepthTextureFormat(depthTexture->pixelFormat());
+            descriptor->setMotionTextureFormat(motionTexture->pixelFormat());
+            descriptor->setOutputTextureFormat(target->pixelFormat());
+            // The rendered content may be smaller than the allocation.
+            descriptor->setInputContentPropertiesEnabled(true);
+            descriptor->setInputContentMinScale(1.0f);
+            descriptor->setInputContentMaxScale(std::max(1.0f,
+                std::max(float(target->width()) / float(std::max<uint32_t>(1, inputWidth)),
+                         float(target->height()) / float(std::max<uint32_t>(1, inputHeight)))));
+            descriptor->setAutoExposureEnabled(false);
+            cache = { device, colorTexture->width(), colorTexture->height(), target->width(), target->height(),
+                colorTexture->pixelFormat(), depthTexture->pixelFormat(), motionTexture->pixelFormat(),
+                target->pixelFormat(), descriptor->newTemporalScaler(device) };
+            descriptor->release();
+            if (cache.scaler == nullptr) {
+                return fail("create_scaler");
+            }
+            reset = true;
+        }
+
+        MTLFX::TemporalScaler *scaler = cache.scaler;
+        const auto usable = [](MTL::Texture *texture, MTL::TextureUsage required) {
+            return (texture->usage() & required) == required;
+        };
+        if (!usable(colorTexture, scaler->colorTextureUsage()) || !usable(depthTexture, scaler->depthTextureUsage()) ||
+            !usable(motionTexture, scaler->motionTextureUsage()) || !usable(target, scaler->outputTextureUsage())) {
+            return fail("texture_usage");
+        }
+
+        list->endOtherEncoders(EncoderType::None);
+        list->activeType = EncoderType::None;
+        scaler->setColorTexture(colorTexture);
+        scaler->setDepthTexture(depthTexture);
+        scaler->setMotionTexture(motionTexture);
+        scaler->setOutputTexture(target);
+        scaler->setInputContentWidth(std::min<NS::UInteger>(inputWidth, colorTexture->width()));
+        scaler->setInputContentHeight(std::min<NS::UInteger>(inputHeight, colorTexture->height()));
+        scaler->setJitterOffsetX(jitterX);
+        scaler->setJitterOffsetY(jitterY);
+        scaler->setMotionVectorScaleX(motionScaleX);
+        scaler->setMotionVectorScaleY(motionScaleY);
+        scaler->setDepthReversed(depthReversed);
+        scaler->setPreExposure(1.0f);
+        scaler->setReset(reset);
+        scaler->encodeToCommandBuffer(list->mtl);
+        return true;
+    }
+
+    bool SupportsMetalFxTemporal(RenderDevice *device) {
+        auto *metalDevice = static_cast<MetalDevice *>(device);
+        return metalDevice != nullptr && metalDevice->mtl != nullptr &&
+            MTLFX::TemporalScalerDescriptor::supportsDevice(metalDevice->mtl);
+    }
+
+    void SetMetalMinimumPresentDuration(RenderSwapChain *swapChain, double seconds) {
+        static_cast<MetalSwapChain *>(swapChain)->minimumPresentDuration.store(seconds, std::memory_order_relaxed);
+    }
+
     std::unique_ptr<RenderInterface> CreateMetalInterface() {
         std::unique_ptr<MetalInterface> createdInterface = std::make_unique<MetalInterface>();
         return createdInterface->isValid() ? std::move(createdInterface) : nullptr;
