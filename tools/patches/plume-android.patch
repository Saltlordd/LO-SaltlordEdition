diff --git a/plume_android_pipeline_cache.h b/plume_android_pipeline_cache.h
new file mode 100644
index 0000000..9dc7605
--- /dev/null
+++ b/plume_android_pipeline_cache.h
@@ -0,0 +1,39 @@
+#pragma once
+#include <vector>
+#include <span>
+#include <cstring>
+#include <cstdint>
+#include <string>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <cerrno>
+namespace plume::android_pipeline_cache {
+inline constexpr size_t MaxBytes=64u*1024u*1024u;
+inline bool Compatible(std::span<const uint8_t> bytes,uint32_t vendor,uint32_t device,const uint8_t* uuid) {
+ if(bytes.size()<32 || bytes.size()>MaxBytes)return false;
+ uint32_t h[4];std::memcpy(h,bytes.data(),16);
+ return h[0]>=32 && h[0]<=bytes.size() && h[1]==1 && h[2]==vendor && h[3]==device &&
+        std::memcmp(bytes.data()+16,uuid,16)==0;
+}
+inline std::vector<uint8_t> Read(const std::string& path) {
+ int fd=open(path.c_str(),O_RDONLY|O_CLOEXEC|O_NOFOLLOW);if(fd<0)return {};
+ struct stat st{};std::vector<uint8_t> bytes;
+ if(fstat(fd,&st)==0 && S_ISREG(st.st_mode) && st.st_size>=32 && uint64_t(st.st_size)<=MaxBytes) {
+  bytes.resize(size_t(st.st_size));size_t n=0;
+  while(n<bytes.size()) {auto got=read(fd,bytes.data()+n,bytes.size()-n);if(got<0 && errno==EINTR)continue;if(got<=0)break;n+=size_t(got);}
+  if(n!=bytes.size())bytes.clear();
+ }
+ close(fd);return bytes;
+}
+inline bool Write(const std::string& path,std::span<const uint8_t> bytes) {
+ if(bytes.size()<32 || bytes.size()>MaxBytes)return false;
+ const auto tmp=path+".tmp";
+ int fd=open(tmp.c_str(),O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC|O_NOFOLLOW,0600);if(fd<0)return false;
+ size_t n=0;
+ while(n<bytes.size()) {auto wrote=write(fd,bytes.data()+n,bytes.size()-n);if(wrote<0 && errno==EINTR)continue;if(wrote<=0)break;n+=size_t(wrote);}
+ bool ok=n==bytes.size() && fsync(fd)==0;if(close(fd)!=0)ok=false;
+ if(ok)ok=rename(tmp.c_str(),path.c_str())==0;
+ if(!ok)unlink(tmp.c_str());return ok;
+}
+}
