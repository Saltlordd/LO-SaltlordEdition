diff --git a/plume_android_loader.h b/plume_android_loader.h
new file mode 100644
--- /dev/null
+++ b/plume_android_loader.h
@@ -0,0 +1,9 @@
+#pragma once
+#include "contrib/volk/volk.h"
+namespace plume {
+// Keep the app-selected custom loader. System fallback explicitly installs
+// its own loader before retrying; desktop bootstrap is unchanged.
+inline VkResult InitializeAndroidVulkanLoader() {
+    return vkGetInstanceProcAddr ? VK_SUCCESS : volkInitialize();
+}
+}
